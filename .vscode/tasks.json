{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Campus Pilot: Install frontend",
      "type": "shell",
      "command": "npm",
      "args": ["ci"],
      "options": { "cwd": "${workspaceFolder}\\frontend" },
      "problemMatcher": []
    },
    {
      "label": "Campus Pilot: Frontend dev server",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": { "cwd": "${workspaceFolder}\\frontend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Campus Pilot: Backend dev server",
      "type": "shell",
      "command": "python",
      "args": ["-m", "uvicorn", "app.main:app", "--reload"],
      "options": { "cwd": "${workspaceFolder}\\backend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Campus Pilot: Frontend build",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build"],
      "options": { "cwd": "${workspaceFolder}\\frontend" },
      "problemMatcher": []
    },
    {
      "label": "Campus Pilot: Frontend tests",
      "type": "shell",
      "command": "npm",
      "args": ["test"],
      "options": { "cwd": "${workspaceFolder}\\frontend" },
      "problemMatcher": []
    },
    {
      "label": "Campus Pilot: Backend tests",
      "type": "shell",
      "command": "python",
      "args": ["-m", "pytest"],
      "options": { "cwd": "${workspaceFolder}\\backend" },
      "problemMatcher": []
    },
    {
      "label": "Campus Pilot: Docker Compose",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "up", "--build"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
